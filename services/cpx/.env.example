GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
LOCK_CONSTRAINTS=true

# LectureLink의 CPX_PROXY_SHARED_SECRET과 반드시 같은 긴 임의 문자열을 사용합니다.
CPX_PROXY_SHARED_SECRET=
REQUIRE_LECTURELINK_AUTH=true

# MVP에서는 임상 검수를 출품 이후로 유예했으므로 false입니다.
CPX_RELEASE_READY_ONLY=false

# 단일 컨테이너의 영속 볼륨을 /data에 연결할 때 사용합니다.
CPX_DB_PATH=/data/cpx.sqlite3
PORT=8787

# 운영 성능 계측 (성능지표 가이드 1단계). 배포마다 버전을 올리면 버전 간 회귀 비교가 됩니다 —
# 커밋 해시를 넣어도 됩니다. CPX_METRICS_ENABLED=false 로 계측을 끌 수 있지만,
# 끄면 성공률·p95·완주율 실측이 통째로 사라지므로 장애 대응 등 예외 상황에서만 씁니다.
CPX_FEATURE_VERSION=cpx-v1
CPX_METRICS_ENABLED=true
# 계측 보존 기간(일). 요청마다 한 줄씩 쌓이므로 상한이 없으면 볼륨이 언젠가 찹니다.
CPX_METRICS_RETENTION_DAYS=90
