{
  "name": "medai-learning-engine",
  "version": "0.1.0",
  "private": true,
  "description": "의료 교육 특화 AI 학습 인프라 — 백엔드 + API",
  "scripts": {
    "design:css": "node scripts/build-redesign-css.mjs",
    "dev": "next dev",
    "build": "node scripts/verify-pricing-consistency.mjs && node scripts/vercel-build-guard.mjs && next build",
    "build:clean": "rm -rf .next && node scripts/verify-pricing-consistency.mjs && node scripts/vercel-build-guard.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "qa:faculty": "npm run lint && npm run typecheck && npm run build && npm audit --omit=dev --audit-level=high",
    "test:auth-handoff": "node scripts/test-request-identity.mjs",
    "cpx:smoke": "node scripts/test-cpx-deployment.mjs",
    "cpx:bundle-check": "node scripts/check-cpx-client-bundle.mjs",
    "cpx:sanitize-check": "node scripts/test-cpx-sanitize.mjs",
    "test:leakage": "node --experimental-strip-types --no-warnings scripts/test-question-leakage.mjs",
    "audit:leakage": "node --experimental-strip-types --no-warnings scripts/audit-question-leakage.mjs",
    "backfill:embeddings": "node scripts/backfill-question-embeddings.mjs",
    "check:revisions": "node --experimental-strip-types --no-warnings scripts/check-question-revisions.mjs",
    "check:pdf": "node --experimental-strip-types --no-warnings scripts/check-pdf-extraction.mjs",
    "check:clinical": "node --experimental-strip-types --no-warnings scripts/check-clinical-vignette.mjs",
    "check:markers": "node --experimental-strip-types --no-warnings scripts/check-image-markers.mjs",
    "check:eta": "node --experimental-strip-types --no-warnings scripts/replay-eta-accuracy.mjs",
    "check:shuffle": "node --experimental-strip-types --no-warnings scripts/check-choice-shuffle.mjs",
    "check:knowledge": "node --experimental-strip-types --no-warnings scripts/check-knowledge-rules.mjs",
    "check:notice": "node --experimental-strip-types --no-warnings scripts/check-upload-notice.mjs",
    "check:material": "node --experimental-strip-types --no-warnings scripts/check-material-focus.mjs",
    "check:metrics": "node --experimental-strip-types --no-warnings scripts/check-metrics.mjs",
    "check:datasets": "node scripts/check-dataset-split.mjs",
    "check:ocr-goldenset": "node scripts/check-ocr-goldenset.mjs",
    "check:item-stats": "node --experimental-strip-types --no-warnings scripts/check-item-stats.mjs",
    "check:reference": "node --experimental-strip-types --no-warnings scripts/check-reference-profile.mjs",
    "check:verify": "node --experimental-strip-types --no-warnings scripts/check-private-verify.mjs",
    "check:blind": "node --experimental-strip-types --no-warnings scripts/check-blind-solve.mjs",
    "check:figure": "node --experimental-strip-types --no-warnings scripts/check-figure-stem.mjs",
    "check:explanation": "node --experimental-strip-types --no-warnings scripts/check-explanation-format.mjs",
    "check:duplicate": "node --experimental-strip-types --no-warnings scripts/check-duplicate-guard.mjs",
    "check:naesin-quality": "node --experimental-strip-types --no-warnings scripts/check-naesin-quality.mjs",
    "deploy:check": "node scripts/assert-production-deploy.mjs",
    "deploy:prod": "npm run deploy:check && vercel --prod",
    "db:types": "supabase gen types typescript --local > lib/types/database.generated.ts",
    "db:types:linked": "supabase gen types typescript --linked > lib/types/database.generated.ts",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/genai": "^2.12.0",
    "@opentelemetry/api": "^1.9.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.46.1",
    "@upstash/qstash": "^2.11.0",
    "canvas": "3.2.3",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "form-data": "4.0.6",
    "lucide-react": "^0.460.0",
    "nanoid": "5.1.16",
    "next": "15.5.23",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "4.10.38",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.3",
    "tesseract.js": "^6.0.1",
    "three": "^0.185.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.11",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.9.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.15.0",
    "eslint-config-next": "15.5.23",
    "postcss": "8.5.26",
    "supabase": "2.114.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "canvas": "3.2.3",
    "next": {
      "postcss": "8.5.26",
      "sharp": "0.35.3"
    },
    "postcss": {
      "nanoid": "3.3.18"
    }
  }
}
